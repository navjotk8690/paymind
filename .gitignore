# Python virtual environments
.venv/
venv/
env/

# Python cache / compiled files
__pycache__/
*.py[cod]
*$py.class

# Packaging
*.egg-info/
build/
dist/

# Test / lint / coverage
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environment / secrets
.env
.env.*
!.env.example

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Git artifacts accidentally copied outside .git
FETCH_HEAD

# Private models
models/private/**
!models/private/.gitkeep

# Runtime-generated files
runtime/**
!runtime/.gitkeep

# Private / generated datasets
data/training/**
!data/training/.gitkeep

data/processed/**
!data/processed/.gitkeep

data/splits/**
!data/splits/.gitkeep

data/reports/**
!data/reports/.gitkeep

# CSV data is private by default
*.csv
!examples/csv/*.csv

# Keep public example request
!examples/request.json

# Logs / temporary files
*.log
*.tmp
*.temp
.cache/